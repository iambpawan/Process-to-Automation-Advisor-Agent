# Which LLM backend the agents use: claude | ollama (placeholder) | offline
# - claude with an empty LLM_API_KEY: the app detects the missing key and runs in offline mode
#   (guided interviewer + template writer). Add the key later and restart; the AI agents switch on.
# - offline: never use an LLM, even if a key is set.
LLM_PROVIDER=claude
LLM_MODEL=claude-sonnet-5-5
# API key for the provider. For Claude you can also leave this empty and set ANTHROPIC_API_KEY.
LLM_API_KEY=

# Claude thinking depth: low | medium | high | xhigh | max
LLM_EFFORT=high

# Where the LLM provider processes data (US, EU, UAE...). Used by the compliance check
# to decide whether PHI/PII that must stay in the UAE may be sent to the model.
# (Picking a live Azure OpenAI "(uaenorth)" runtime model in the app overrides this for the cost/AI decision.)
LLM_DATA_REGION=US

# Default currency when the interview doesn't capture one (needs an FX rate in pricing_assumptions.json)
CURRENCY=USD

# Live public data (only fetched when you click "Refresh live prices & FX"; no key needed)
# Azure region for Azure OpenAI / Document Intelligence list prices
LIVE_PRICE_REGION=uaenorth
# Cache file for live data (default advisor/data/live_cache.json)
LIVE_CACHE_PATH=

# Used later by the Ollama provider
OLLAMA_BASE_URL=http://localhost:11434
